{
  "manifest_version": 3,
  "name": "网页沉浸式翻译",
  "version": "0.1.0",
  "description": "使用自带 Key 的 LLM 配置翻译网页。",
  "permissions": ["activeTab", "contextMenus", "scripting", "storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "icons": {
    "16": "icons/translation-16.png",
    "32": "icons/translation-32.png",
    "48": "icons/translation-48.png",
    "128": "icons/translation-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/translation-16.png",
      "32": "icons/translation-32.png",
      "48": "icons/translation-48.png",
      "128": "icons/translation-128.png"
    },
    "default_popup": "popup.html",
    "default_title": "翻译当前网页"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html"
}
