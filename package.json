{
  "name": "better-immersivetranslate",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs && tsc",
    "package": "npm run build && node scripts/package.mjs",
    "test:release": "node --test tests/release/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:release && npm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/chrome": "0.0.326",
    "@types/node": "24.1.0",
    "typescript": "5.8.3"
  }
}
